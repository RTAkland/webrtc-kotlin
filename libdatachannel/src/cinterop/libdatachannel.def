package = libdatachannel
headers = rtc/rtc.h
# RTC_STATIC is required since libdatachannel 0.24.7: without it the Windows
# header expands RTC_C_EXPORT to __declspec(dllimport), which breaks linking
# against the static .a files.
compilerOpts = -DRTC_STATIC -DRTC_ENABLE_WEBSOCKET=0 -DRTC_ENABLE_MEDIA=0
staticLibraries = libdatachannel.a libjuice.a libusrsctp.a
linkerOpts.linux = -lpthread -ldl -lm -lstdc++ --warn-unresolved-symbols
linkerOpts.mingw = -lws2_32 -liphlpapi
